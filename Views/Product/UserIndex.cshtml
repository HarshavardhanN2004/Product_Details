@model Product_Details.ViewModels.UserIndexViewModel
@{
    ViewData["Title"] = "Products";
}

<h2 class="text-center mb-4">Available Products</h2>
<div class="d-flex justify-content-end mb-3">

    <form asp-action="UserIndex"
          method="get"
          class="d-flex align-items-center gap-2 flex-wrap">

        <input type="text"
               name="search"
               class="form-control form-control-sm"
               style="width:220px;"
               placeholder="Product Name / Type"
               value="@ViewBag.Search" />

        <input type="text"
               name="priceRange"
               class="form-control form-control-sm"
               style="width:150px;"
               placeholder="200-500"
               value="@ViewBag.PriceRange" />

        <button type="submit"
                class="btn btn-primary btn-sm">

            <i class="bi bi-search"></i>

        </button>

        <a asp-action="UserIndex"
           class="btn btn-secondary btn-sm">

            <i class="bi bi-arrow-clockwise"></i>

        </a>

    </form>

</div>

@if (!Model.Products.Any())
{
    <div class="alert alert-warning text-center">
        <h5>Product not found for your search.</h5>
    </div>
}

<div class="container-fluid">

    <div class="row g-3 align-items-start">

        @foreach (var item in Model.Products)
        {
            <div class="col-12 col-md-4">

                <div class="card product-card border-0 rounded-4">

                    <h6 class="fw-bold">
                        @item.ProductName
                    </h6>

                    <span class="badge bg-secondary">
                        @item.Type
                    </span>

                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="@item.ImagePath"
                             class="card-img-top rounded-top-4"
                             style="height:150px;object-fit:cover;" />
                    }
                    else
                    {
                        <img src="https://via.placeholder.com/300x170?text=No+Image"
                             class="card-img-top rounded-top-4"
                             style="height:150px;object-fit:cover;" />
                    }

                   <div class="card-body py-2 text-center">

                        <p class="mb-1">

                            <strong>Price :</strong>

                            <span class="text-success">

                                ₹ @item.Price

                            </span>

                        </p>

                        @if (item.Quantity > 0)
                        {
                            <p class="mb-2">
                                <strong>Quantity :</strong>

                                <span class="badge bg-success">
                                    @item.Quantity
                                </span>
                            </p>
                        }
                        else
                        {
                            <p class="mb-2">
                                <span class="badge bg-danger fs-6">
                                    Out of Stock
                                </span>
                            </p>
                        }

                        <p class="small text-muted mb-0">

                            @item.Description

                        </p>

                   </div>
                   
                    <div class="d-flex justify-content-center align-items-center gap-2 mt-2">

                        @if (item.Quantity > 0)
                        {
                            <form asp-action="AddToCart" method="post">

                                <input type="hidden"
                                       name="productId"
                                       value="@item.ProductId" />

                                <button type="submit"
                                        class="btn btn-success btn-sm">

                                    <i class="bi bi-cart-plus"></i>

                                </button>

                            </form>

                            <a asp-action="BuyNow"
                               asp-route-id="@item.ProductId"
                               class="btn btn-primary btn-sm">
                                Buy Now
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-secondary btn-sm" disabled>
                                <i class="bi bi-cart-plus"></i>
                            </button>

                            <button class="btn btn-secondary btn-sm" disabled>
                                Buy Now
                            </button>
                        }

                    </div>

                </div>

            </div>
        }

    </div>

</div>

@if (ViewBag.TotalPages > 1)
{
    <nav aria-label="Product pagination" class="mt-4">
        <ul class="pagination justify-content-center">

            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">

                <a class="page-link"
                   asp-action="UserIndex"
                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                   asp-route-search="@ViewBag.Search"
                   asp-route-priceRange="@ViewBag.PriceRange">

                    Previous

                </a>

            </li>

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">

                    <a class="page-link"
                       asp-action="UserIndex"
                       asp-route-page="@i"
                       asp-route-search="@ViewBag.Search"
                       asp-route-priceRange="@ViewBag.PriceRange">

                        @i

                    </a>

                </li>
            }

            <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">

                <a class="page-link"
                   asp-action="UserIndex"
                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                   asp-route-search="@ViewBag.Search"
                   asp-route-priceRange="@ViewBag.PriceRange">

                    Next

                </a>

            </li>

        </ul>
    </nav>
}

<script>
  var productPrice = 0;
  var stock = 0;
        function increaseQty()
    {
        var qty = document.getElementById("BuyQuantity");

        if (parseInt(qty.value) < stock)
        {
            qty.value++;

            calculateTotal();
        }
    }

        function decreaseQty()
    {
        var qty = document.getElementById("BuyQuantity");

        if (parseInt(qty.value) > 1)
        {
            qty.value--;

            calculateTotal();
        }
    }

        function calculateTotal()
    {
        var qty = document.getElementById("BuyQuantity").value;

        document.getElementById("TotalAmount").value =
            qty * productPrice;
    }

       function showNewAddress()
    {
        document.getElementById("newAddressDiv").style.display = "block";

        document.getElementById("IsAddressChanged").value = "true";
    }
</script>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}