@model Product_Details.ViewModels.CheckoutPageViewModel

@{
    ViewData["Title"] = "Checkout";
}

<div class="container mt-4">

    <h3 class="mb-4">
        Checkout
    </h3>

    <form asp-action="PlaceOrder" method="post">

        <input type="hidden" asp-for="Name" value="@Model.Name" />
        <input type="hidden" asp-for="Phone" value="@Model.Phone" />
        <input type="hidden" asp-for="Address" value="@Model.Address" />
        <input type="hidden" asp-for="City" value="@Model.City" />
        <input type="hidden" asp-for="Pincode" value="@Model.Pincode" />

        <input asp-for="ProductId" type="hidden" />
        <input asp-for="Price" type="hidden" />
        <input asp-for="ProductName" type="hidden" />
        <input asp-for="Stock" type="hidden" />

        <div class="card shadow border-0 rounded-4 mb-4">

            <div class="card-body p-4">

                <div class="row align-items-center">

                    <div class="col-md-4 text-center">

                        <img src="@Model.ImagePath"
                             class="img-fluid rounded-3 border"
                             style="height:220px;object-fit:contain;" />

                    </div>

                    <div class="col-md-8">

                        <h3 class="fw-bold mb-4">
                            @Model.ProductName
                        </h3>

                        <div class="d-flex justify-content-between mb-3">

                            <span class="fw-semibold text-secondary">
                                Price
                            </span>

                            <span class="fs-5 fw-bold text-success">

                                ₹ <span id="price">@Model.Price</span>

                            </span>

                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <span class="fw-semibold text-secondary">

                                Quantity

                            </span>

                            <div class="d-flex align-items-center">

                                <button type="button"
                                        class="btn btn-danger rounded-circle"
                                        style="width:40px;height:40px;"
                                        onclick="decreaseQty()">

                                    <i class="bi bi-dash-lg"></i>

                                </button>

                                <input asp-for="Quantity"
                                       id="qty"
                                       class="form-control text-center mx-2 fw-bold"
                                       style="width:65px;"
                                       readonly />

                                <button type="button"
                                        class="btn btn-success rounded-circle"
                                        style="width:40px;height:40px;"
                                        onclick="increaseQty()">

                                    <i class="bi bi-plus-lg"></i>

                                </button>

                            </div>

                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">

                            <span class="fw-bold fs-5">

                                Total Amount

                            </span>

                            <span class="fs-3 fw-bold text-primary">

                                ₹ <span id="total">@Model.TotalAmount</span>

                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="card border-0 shadow rounded-4 mb-4">

            <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">

                <h4 class="mb-0">

                    <i class="bi bi-geo-alt-fill text-danger me-2"></i>

                    Delivery Address

                </h4>

                <button type="button"
                        class="btn btn-outline-primary rounded-pill px-4"
                        onclick="showAddressForm()">

                    <i class="bi bi-pencil-square"></i>

                    Change

                </button>

            </div>

            <div class="card-body">

                <h5 class="fw-bold mb-2">

                    @Model.Name

                </h5>

                <p class="mb-2">

                    <i class="bi bi-telephone-fill text-success me-2"></i>

                    @Model.Phone

                </p>

                <p class="mb-2">

                    <i class="bi bi-house-door-fill text-primary me-2"></i>

                    @Model.Address

                </p>

                <p class="mb-2">

                    <i class="bi bi-buildings-fill text-warning me-2"></i>

                    @Model.City

                </p>

                <p class="mb-0">

                    <i class="bi bi-mailbox2 text-secondary me-2"></i>

                    @Model.Pincode

                </p>

            </div>

        </div>

        <div id="addressForm"
             style="display:none;">

            <input asp-for="ChangeAddress"
                   type="hidden"
                   id="ChangeAddress" />

            <div class="card border-0 shadow rounded-4 mb-4">

                <div class="card-header bg-warning text-dark">

                    <h5 class="mb-0">

                        <i class="bi bi-pencil-square me-2"></i>

                        Update Delivery Address

                    </h5>

                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-semibold">

                                Full Name

                            </label>

                            <input asp-for="NewName"
                                   class="form-control rounded-3" />

                            <span asp-validation-for="NewName"
                                  class="text-danger"></span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-semibold">

                                Mobile Number

                            </label>

                            <input asp-for="NewPhone"
                                   class="form-control rounded-3" />

                            <span asp-validation-for="NewPhone"
                                  class="text-danger"></span>

                        </div>

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-semibold">

                            Address

                        </label>

                        <textarea asp-for="NewAddress"
                                  rows="4"
                                  class="form-control rounded-3"></textarea>

                        <span asp-validation-for="NewAddress"
                              class="text-danger"></span>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-semibold">

                                City

                            </label>

                            <input asp-for="NewCity"
                                   class="form-control rounded-3" />

                            <span asp-validation-for="NewCity"
                                  class="text-danger"></span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label fw-semibold">

                                Pincode

                            </label>

                            <input asp-for="NewPincode"
                                   class="form-control rounded-3" />

                            <span asp-validation-for="NewPincode"
                                  class="text-danger"></span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="d-flex justify-content-between mt-4">

            <a asp-action="UserIndex"
               class="btn btn-outline-secondary btn-lg px-4">

                <i class="bi bi-arrow-left"></i>

                Back

            </a>

            <button type="submit"
                    class="btn btn-success btn-lg px-5">

                <i class="bi bi-bag-check-fill"></i>

                Place Order

            </button>

        </div>

    </form>

</div>

<script>

    var price = @Model.Price;
    var stock = @Model.Stock;

       function increaseQty() {

        var qty = document.getElementById("qty");

        if (parseInt(qty.value) < stock)
        {
            qty.value++;
            calculateTotal();
        }
        else
        {
            alert("Only " + stock + " item(s) available.");
        }
    }

    function decreaseQty() {

        var qty = document.getElementById("qty");

        if (qty.value > 1)
            qty.value--;

        calculateTotal();

    }

    function calculateTotal() {

        var qty = document.getElementById("qty").value;

        document.getElementById("total").innerHTML =
            qty * price;

    }

        function showAddressForm() {

        document.getElementById("addressForm").style.display = "block";

        document.getElementById("ChangeAddress").value = "true";

        var form = $("form");

        form.removeData("validator");
        form.removeData("unobtrusiveValidation");

        $.validator.unobtrusive.parse(form);
    }

</script>
@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}