@model Product_Details.Models.Product

@{
    ViewData["Title"] = "Delete Product";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Delete Product</h2>

<h4 class="text-danger">
    Are you sure you want to delete this product?
</h4>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Product Name
    </dt>

    <dd class="col-sm-9">
        @Model.ProductName
    </dd>

    <dt class="col-sm-3">
        Description
    </dt>

    <dd class="col-sm-9">
        @Model.Description
    </dd>

    <dt class="col-sm-3">
        Price
    </dt>

    <dd class="col-sm-9">
        @Model.Price
    </dd>

    <dt class="col-sm-3">
        Quantity
    </dt>

    <dd class="col-sm-9">
        @Model.Quantity
    </dd>

</dl>

<form asp-action="DeleteConfirmed" method="post">

    <input type="hidden" asp-for="ProductId" />

    <div class="text-end mt-4">

        <button type="submit"
                class="btn btn-delete">

            <i class="bi bi-trash3-fill"></i>
            Delete Product

        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </div>  

</form>